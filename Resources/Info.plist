<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>FrameScrub</string>
    <key>CFBundleDisplayName</key><string>FrameScrub</string>
    <key>CFBundleIdentifier</key><string>local.framescrub</string>
    <key>CFBundleExecutable</key><string>FrameScrub</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.2.0</string>
    <key>CFBundleVersion</key><string>2</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <!-- The Stash server (stash-url) is plain HTTP on the local network. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- A plugin page (plugin=) or a Stash stream may be plain HTTP on a VPN address, which ATS does not count as
             local. NSAllowsArbitraryLoads alone: with NSAllowsLocalNetworking beside it, macOS ignores it. -->
        <key>NSAllowsArbitraryLoads</key><true/>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <!-- framescrub://open?path=<percent-encoded absolute path>, see OpenLink. -->
        <dict>
            <key>CFBundleURLName</key><string>FrameScrub link</string>
            <key>CFBundleURLSchemes</key><array><string>framescrub</string></array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- One type per format with its own icon (Resources/DocumentIcons/<ext>.icns): Finder shows it for
             files whose default app is FrameScrub. mts/m2ts and mpg/mpeg share one system type each. -->
        <dict>
            <key>CFBundleTypeName</key><string>MPEG-4 Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>mp4</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.mpeg-4</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>MPEG-4 Video (M4V)</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>m4v</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.apple.m4v-video</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>3GPP Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>3gp</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.3gpp</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>QuickTime Movie</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>mov</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.apple.quicktime-movie</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>Matroska Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>mkv</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>org.matroska.mkv</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>WebM Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>webm</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>org.webmproject.webm</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>AVI Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>avi</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.avi</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>Windows Media Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>wmv</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.microsoft.windows-media-wmv</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>AVCHD Video (MTS, M2TS)</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>mts</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.avchd-mpeg-2-transport-stream</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>MPEG-2 Transport Stream</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>ts</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.mpeg-2-transport-stream</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>MPEG Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>mpg</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.mpeg</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>Flash Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeIconFile</key><string>flv</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.adobe.flash.video</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>Video</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <!-- Any other video: Finder draws the document icon from the app icon. -->
            <key>CFBundleTypeIconSystemGenerated</key><integer>1</integer>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.audiovisual-content</string>
            </array>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>org.matroska.mkv</string>
            <key>UTTypeDescription</key><string>Matroska Video</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.movie</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>mkv</string></array>
                <key>public.mime-type</key>
                <array><string>video/x-matroska</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>org.webmproject.webm</string>
            <key>UTTypeDescription</key><string>WebM Video</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.movie</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>webm</string></array>
                <key>public.mime-type</key>
                <array><string>video/webm</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
